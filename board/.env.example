# Claude Bot Bridge Board: server settings. Copy to .env and fill in. Never commit .env.
# Generate every value with the owner CLI, e.g.:  node client/board.mjs keygen --role owner
# (the key is printed once; the server only needs its SHA-256).

# Access keys, as SHA-256 hex (64 characters). Each role needs a different key.
OWNER_KEY_SHA256=replace-with-64-hex-characters
WORKER_KEY_SHA256=replace-with-64-hex-characters
VIEWER_KEY_SHA256=replace-with-64-hex-characters

# Encrypts task text at rest (AES-256-GCM). `node client/board.mjs keygen --encryption-key`. Back it up.
BOARD_ENCRYPTION_KEY=replace-with-base64-of-32-random-bytes
# Only while rotating the key: the key you are replacing.
# BOARD_ENCRYPTION_KEY_PREVIOUS=

# Signs web board sessions. `node client/board.mjs keygen --session-secret`
SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional
# WORKER_NAME=Muse
# WORKER_RATE_LIMIT_PER_MIN=60
# TRUST_PROXY=1            # only behind exactly one reverse proxy you control
# HOST=127.0.0.1           # the Docker image sets 0.0.0.0
# PORT=8787
# DB_PATH=./data/board.sqlite
